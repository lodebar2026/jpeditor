    "opencc-js": "^1.4.1",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "^6.1.200",
    "smplr": "^1.0.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/cli": "^2",
