  "license": "MIT",
  "keywords": [
    "jianpu",
    "numbered-notation",
    "music-notation",
    "sheet-music",
    "musicxml",
    "jpwabc",
    "fanqie-jianpu",
    "jianpu-text",
    "omr",
    "abc-notation",
    "pptx",
    "tauri",
    "svg"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
